# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./samachar.db

# ── Redis (optional, for rate limiting) ──
REDIS_URL=redis://localhost:6379/0

# ── Auth (SuperTokens) ──
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
# Leave empty to disable SuperTokens (auth endpoints will be unavailable)
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:8000

# ── Legacy Auth (kept for backward compatibility) ──
SECRET_KEY=
# If not set, auto-generated and persisted to .secret_key file

# ── CORS ──
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Rate limiting ──
RATE_LIMIT_PER_MINUTE=20

# ── Observability ──
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR
SENTRY_DSN=
# Get from https://sentry.io — leave empty to disable
PROMETHEUS_ENABLED=true

# ── External APIs ──
NEWS_API_KEY=
