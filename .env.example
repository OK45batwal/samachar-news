# ── Railway (set in Dashboard) ──
# PORT=          ← set automatically by Railway

# ── Database ──
# Railway PostgreSQL plugin sets DATABASE_URL automatically
# For local dev:
DATABASE_URL=sqlite+aiosqlite:///./samachar.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/samachar

# ── Redis (optional, for rate limiting) ──
# Railway Redis plugin sets REDIS_URL automatically
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
SECRET_KEY=
# If not set, auto-generated and persisted to .secret_key file

# ── CORS ──
# On Railway, set to your domain, e.g. https://samachar.up.railway.app
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Rate limiting ──
RATE_LIMIT_PER_MINUTE=20

# ── Observability ──
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR
SENTRY_DSN=
# Get from https://sentry.io — leave empty to disable
PROMETHEUS_ENABLED=true

# ── External APIs ──
NEWS_API_KEY=
