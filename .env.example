# ==============================================================================
# Samachar Truth Intelligence Platform — Environment Configuration Template
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# JWT Secret Key (MANDATORY in production: generate with `openssl rand -hex 32`)
SECRET_KEY=your-32-byte-hex-secret-key-here
SAMACHAR_JWT_SECRET=

# Database Connection (Default: SQLite local database; Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./samachar.db

# API and CORS settings
API_DOMAIN=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,https://samachar-news-2026.web.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Feed Ingestion Schedule
FEED_INGESTION_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_FEED=25

# Cache & Message Broker (Optional Redis)
REDIS_URL=redis://localhost:6379/0

# SMTP / Email Configuration (For OTP verification & password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@samachar.news
SMTP_FROM_NAME="Samachar Truth Intelligence"

# Monitoring & Analytics (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false

