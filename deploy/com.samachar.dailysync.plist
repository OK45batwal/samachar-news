<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.samachar.dailysync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/omkar/samachar-news/scripts/auto_daily_sync.sh</string>
    </array>

    <!-- Run every day at 04:30 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/omkar/samachar-news/logs/launchd_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/omkar/samachar-news/logs/launchd_sync.log</string>
</dict>
</plist>
