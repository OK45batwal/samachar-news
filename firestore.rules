rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'batwalomkar19@gmail.com');
    }

    // Categories: Publicly readable, writeable only by admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // News Sources: Publicly readable, writeable only by admin
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles: Publicly readable for published articles or admin preview
    match /articles/{articleId} {
      allow read: if resource == null || resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // User Bookmarks: Strictly isolated per user UID
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isOwner(userId);
    }

    // User Profiles: Strictly isolated per user UID
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Public Fact Check Workbench Queries
    match /fact_check_queries/{queryId} {
      allow read: if true;
      allow create: if request.resource.data.query_text is string && request.resource.data.query_text.size() > 0 && request.resource.data.query_text.size() < 10000;
      allow update, delete: if isAdmin();
    }
  }
}
